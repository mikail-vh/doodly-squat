# Copy to deploy/behind-caddy/.env on the VPS. That file is gitignored.

# Must match the public URL exactly: scheme included, no trailing slash.
# It builds the OAuth redirect URI and decides whether session cookies are
# marked Secure.
APP_URL=https://squat.mvhuysie.com
APP_NAME=Doodly Squat

# A provider appears in the UI only once both of its halves are set.
# Redirect URI to register: https://squat.mvhuysie.com/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI to register: https://squat.mvhuysie.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer token for POST /api/stats/results. Leave blank to keep it disabled.
#   openssl rand -base64 32
STATS_INGEST_TOKEN=
