# Copy to deploy/coolify.env and fill in. That file is gitignored.

# --- talking to Coolify ---------------------------------------------------
# Your Coolify instance, and a token from Keys & Tokens -> API tokens.
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=
# Only needed if the instance has more than one server attached.
SERVER_UUID=

# --- where Coolify pulls the code from ------------------------------------
GIT_REPOSITORY=https://github.com/mikail-vh/doodly-squat
GIT_BRANCH=main

# --- how it is filed inside Coolify ---------------------------------------
PROJECT_NAME=Doodly Squat
ENVIRONMENT_NAME=production
APP_NAME_SLUG=doodly-squat

# --- passed through to the running container ------------------------------
# Must match the domain exactly: scheme included, no trailing slash.
APP_URL=https://squat.mvhuysie.com
APP_NAME=Doodly Squat

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
STATS_INGEST_TOKEN=
