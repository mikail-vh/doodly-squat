# Standalone deployment only (deploy/standalone). Coolify sets the domain in
# its own UI and ignores this.
DOMAIN=squat.mvhuysie.com

# Must match DOMAIN exactly, including the scheme and no trailing slash.
# Sign-in cookies are only marked Secure when this starts with https://.
APP_URL=https://squat.mvhuysie.com

# Shown as the issuer in authenticator apps.
APP_NAME=Doodly Squat

# Sign-in providers. Each one switches on as soon as both halves are present,
# so you can run Discord-only and add Google later.
# Redirect URI to register: https://your-domain/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Redirect URI to register: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer token the game server will present to POST /api/stats/results.
# Leave blank to keep that endpoint disabled. Generate with:
#   openssl rand -base64 32
STATS_INGEST_TOKEN=
